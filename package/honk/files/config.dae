# config.dae
# Load all honk files placed in ./config.d/.
include {
    config.d/*.dae
}

global {
    log_level: warn
    check_interval: 600s
    check_tolerance: 30ms
    lan_interface: br-lan
    wan_interface: auto
    auto_config_kernel_parameter: true
    disable_waiting_network: false
    data_dir: '/etc/honk'
    log_file: '/var/log/honk/honk.log'
    store_subscribe: true
    # if u not using dns bind, set dial_mode to domain++ prefer
    dial_mode: domain
    bootstrap_resolver: '223.5.5.5:53'
    tcp_check_url: 'https://www.gstatic.com/generate_204'
    tcp_check_http_method: HEAD
    udp_check_dns: 'dns.google.com:53', '8.8.8.8', '2001:4860:4860::8888'
}

routing {
    pname(dnsmasq, zerotier-one) -> direct(must)
    dip(224.0.0.0/3, 'ff00::/8', geoip: private) -> direct(must)
    domain(geosite: category-bank-cn, geosite: boc@!cn, geosite: synology) -> direct

    # block quic, if u node has poor quic support, enable this line
    # l4proto(udp) && dport(443) -> block

    domain(geosite: spotify) -> proxy
    domain(geosite: category-doh) -> proxy
    domain(geosite: tiktok) -> proxy
    domain(geosite: category-ai-!cn, geosite: github) -> proxy
    domain(geosite: gfw) -> proxy

    dip(geoip: telegram) -> proxy

    dip(geoip: cn) -> direct
    # geoip:cn always using chiness asn, can use domain rule to override
    # domain(geosite: cn) -> direct

    # using proxy for ssh, http, https, and common ports, avoid (bt, or other p2p)
    # dport(22, 80, 443, 8080, 6443, 9090) -> proxy

    # fallback: direct
    fallback: proxy
}

assets {
    geodata {
        geosite: 'https://tvv.tw/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/release/geosite.dat'
        geoip: 'https://tvv.tw/https://raw.githubusercontent.com/QiuSimons/geoip-moedove/refs/heads/main/geoip.dat'
    }
}
