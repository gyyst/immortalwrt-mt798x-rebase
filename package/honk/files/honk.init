#!/bin/sh /etc/rc.common

USE_PROCD=1
START=96
STOP=10

extra_command "hot_reload" "Hot-reload service"
extra_command "local_direct" "Refresh local direct rules"

CONF="honk"
PROG="/usr/bin/honk-core"
API_FILE="/etc/honk/config.d/api.dae"
LOCAL_DIRECT_FILE="/etc/honk/config.d/00-local-direct.dae"
# honk-core hardcodes dae-compatible datapath names (dae0/dae0peer + daens);
# these are the real interface/netns names, not leftover dae config.
HONK_HOST_IFACE="dae0"
HONK_PEER_IFACE="dae0peer"
HONK_NETNS_NAME="daens"
HONK_NETNS_PATH="/run/netns/$HONK_NETNS_NAME"
RESOLV_HONK="/tmp/resolv.conf.honk"

set_chmod_640() {
    mkdir -p /etc/honk/config.d /etc/honk/state /var/log/honk
    chmod -R u=rwX,go= /etc/honk 2>/dev/null || true
    chmod 700 /etc/honk /etc/honk/config.d /etc/honk/state 2>/dev/null || true
}

get_lan_ip() {
    local ip
    ip=$(ubus call network.interface.lan status 2>/dev/null | \
        sed -n 's/.*"address"[[:space:]]*:[[:space:]]*"\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\)".*/\1/p' | head -n 1)
    [ -n "$ip" ] || ip=$(uci -q get network.lan.ipaddr 2>/dev/null)
    case "$ip" in
        ''|*[!0-9.]*) ip="" ;;
    esac
    printf '%s' "$ip"
}

gen_secret() {
    local s
    s=$(cat /proc/sys/kernel/random/uuid 2>/dev/null | tr -d '-')
    case "$s" in
        ''|*[!0-9a-f]*) s="" ;;
    esac
    [ ${#s} -eq 32 ] || s=""
    if [ -z "$s" ]; then
        s=$(head -c 32 /dev/urandom 2>/dev/null | base64 | tr -dc 'A-Za-z0-9' | cut -c1-32)
        [ ${#s} -ge 24 ] || s=""
    fi
    [ -n "$s" ] && printf '%s' "$s"
}

load_module() {
    [ -d "/sys/module/$1" ] && return 0
    command -v modprobe >/dev/null 2>&1 && modprobe "$1" 2>/dev/null
    [ -d "/sys/module/$1" ] && return 0
    grep -q "^$1 " /proc/modules 2>/dev/null
}

preflight() {
    local module
    if [ ! -r /sys/kernel/btf/vmlinux ]; then
        logger -t honk "preflight failed: kernel BTF is missing (/sys/kernel/btf/vmlinux)"
        return 1
    fi
    if ! grep -q ' /sys/fs/bpf bpf ' /proc/mounts; then
        logger -t honk "preflight failed: bpffs is not mounted at /sys/fs/bpf"
        return 1
    fi
    for module in sch_ingress cls_bpf veth nft_queue nfnetlink_queue; do
        if ! load_module "$module"; then
            logger -t honk "preflight failed: kernel module $module is unavailable"
            return 1
        fi
    done
    return 0
}

check_conflicts() {
    local name
    for name in dae daed clash clashoo mihomo sing-box; do
        if pidof "$name" >/dev/null 2>&1; then
            logger -t honk "refusing to start: conflicting proxy process '$name' is running"
            return 1
        fi
    done
    for name in dae daed clashoo mihomo sing-box; do
        if [ -x "/etc/init.d/$name" ] && "/etc/init.d/$name" running >/dev/null 2>&1; then
            logger -t honk "refusing to start: conflicting proxy service '$name' is running"
            return 1
        fi
    done
    return 0
}

api_secret_value() {
    sed -n "s/^[[:space:]]*secret:[[:space:]]*'\([^']*\)'.*/\1/p" "$1" | head -n 1
}

api_listen_value() {
    sed -n "s/^[[:space:]]*listen:[[:space:]]*'\([^']*\)'.*/\1/p" "$1" | head -n 1
}

sync_api_config() {
    [ -f "$API_FILE" ] || return 0
    if [ -L "$API_FILE" ]; then
        logger -t honk "refusing symlinked API config $API_FILE"
        return 1
    fi

    local tmp sec listen host port target_ip changed new_secret rewrite
    tmp="$API_FILE.tmp.$$"
    sec=$(api_secret_value "$API_FILE")
    listen=$(api_listen_value "$API_FILE")
    host=""
    port=""
    case "$listen" in
        *:*)
            host=${listen%:*}
            port=${listen##*:}
            ;;
        '')
            ;;
        *)
            port=$listen
            ;;
    esac
    target_ip=$(get_lan_ip)
    [ -n "$target_ip" ] || target_ip="127.0.0.1"
    changed=0

    cp -p "$API_FILE" "$tmp" || return 1

    if [ -n "$sec" ] && { [ "$sec" = "honk114514" ] || [ ${#sec} -lt 16 ]; }; then
        new_secret=$(gen_secret)
        if [ -z "$new_secret" ]; then
            rm -f "$tmp"
            logger -t honk "failed to generate a replacement API secret"
            return 1
        fi
        sed -i "s|^\([[:space:]]*secret:[[:space:]]*\)'[^']*'|\1'$new_secret'|" "$tmp" || { rm -f "$tmp"; return 1; }
        if [ "$(api_secret_value "$tmp")" != "$new_secret" ]; then
            rm -f "$tmp"
            logger -t honk "failed to rotate insecure API secret"
            return 1
        fi
        changed=1
        logger -t honk "rotated insecure API secret"
    fi

    if [ -n "$port" ]; then
        rewrite=0
        case "$host" in
            0.0.0.0|::|\[::\]|'')
                rewrite=1
                ;;
            *)
                ip -o addr show 2>/dev/null | grep -Fq " $host/" || rewrite=1
                ;;
        esac
        if [ "$rewrite" = 1 ]; then
            sed -i "s|^\([[:space:]]*listen:[[:space:]]*\)'[^']*'|\1'$target_ip:$port'|" "$tmp"
            if [ "$(api_listen_value "$tmp")" = "$target_ip:$port" ]; then
                changed=1
                logger -t honk "moved API listener to $target_ip:$port"
            else
                logger -t honk "warning: could not rewrite API listener; check $API_FILE"
            fi
        fi
    fi

    if [ "$changed" = 1 ]; then
        chmod 600 "$tmp" || { rm -f "$tmp"; return 1; }
        mv -f "$tmp" "$API_FILE" || { rm -f "$tmp"; return 1; }
        logger -t honk "updated API listen/secret configuration"
    else
        rm -f "$tmp"
    fi
    return 0
}

local_direct_addresses() {
    local list="" net dev addr
    . /lib/functions/network.sh
    for net in lan wan wan6; do
        network_get_device dev "$net" || continue
        case "$dev" in
            ''|*[!A-Za-z0-9_.-]*) continue ;;
        esac
        for addr in $(ip -o addr show dev "$dev" 2>/dev/null | awk '/inet6? / { split($4, a, "/"); print a[1] }'); do
            case "$addr" in
                ''|fe80:*|169.254.*) continue ;;
                *[!0-9a-fA-F:.]*) continue ;;
            esac
            case " $list " in
                *" '$addr'"*) continue ;;
            esac
            list="${list:+$list, }'$addr'"
        done
    done
    printf '%s\n' "$list"
}

sync_local_direct() {
    local ips tmp
    ips=$(local_direct_addresses)
    if [ -z "$ips" ]; then
        rm -f "$LOCAL_DIRECT_FILE"
        return 0
    fi
    mkdir -p /etc/honk/config.d
    tmp="$LOCAL_DIRECT_FILE.tmp.$$"
    {
        echo "# Generated by /etc/init.d/honk; do not edit."
        echo "routing {"
        echo "    dip($ips) -> direct(must)"
        echo "}"
    } > "$tmp" || { rm -f "$tmp"; return 1; }
    chmod 600 "$tmp" || { rm -f "$tmp"; return 1; }
    mv -f "$tmp" "$LOCAL_DIRECT_FILE" || { rm -f "$tmp"; return 1; }
    return 0
}

cleanup_netns() {
    if pidof honk-core >/dev/null 2>&1; then
        logger -t honk "refusing to reclaim datapath resources: honk-core is still running"
        return 1
    fi

    ip netns del "$HONK_NETNS_NAME" 2>/dev/null || true
    umount "$HONK_NETNS_PATH" 2>/dev/null || true
    rm -f "$HONK_NETNS_PATH" 2>/dev/null || true
    ip link del "$HONK_HOST_IFACE" 2>/dev/null || true
    ip link del "$HONK_PEER_IFACE" 2>/dev/null || true

    if ip link show "$HONK_HOST_IFACE" >/dev/null 2>&1 || \
       ip link show "$HONK_PEER_IFACE" >/dev/null 2>&1; then
        logger -t honk "stale datapath interfaces remain; refusing to start"
        return 1
    fi
    if ip netns list 2>/dev/null | awk '{print $1}' | grep -qx "$HONK_NETNS_NAME"; then
        logger -t honk "stale netns $HONK_NETNS_NAME remains; refusing to start"
        return 1
    fi
    return 0
}

hijack_resolv_conf() {
    grep -q ' /tmp/resolv\.conf ' /proc/mounts && return 0

    local dns_list WANS
    . /lib/functions/network.sh
    unset -v __NETWORK_CACHE
    __network_ifstatus WANS "" "[@.route[@.target='0.0.0.0' && !@.table]].interface" 2>/dev/null
    set -- $WANS

    if [ $# -eq 1 ]; then
        dns_list=$(ubus call "network.interface.$1" status 2>/dev/null | \
            jsonfilter -e '@["dns-server"][*]' 2>/dev/null)
        if [ -z "$dns_list" ] && [ -f "/tmp/resolv.conf.d/resolv.conf.auto" ]; then
            dns_list=$(awk '/^nameserver/{print $2}' "/tmp/resolv.conf.d/resolv.conf.auto")
        fi
    fi

    [ -z "$dns_list" ] && dns_list="119.29.29.29 223.5.5.5"

    [ -f /tmp/resolv.conf ] || touch /tmp/resolv.conf
    grep -E '^(search|domain) ' /tmp/resolv.conf > "$RESOLV_HONK" 2>/dev/null

    for dns in $dns_list; do
        echo "nameserver $dns" >> "$RESOLV_HONK"
    done

    mount --bind "$RESOLV_HONK" /tmp/resolv.conf
    mount -o remount,ro,bind /tmp/resolv.conf
}

restore_resolv_conf() {
    while grep -q ' /tmp/resolv\.conf ' /proc/mounts; do
        mount -o remount,rw,bind /tmp/resolv.conf 2>/dev/null
        umount /tmp/resolv.conf 2>/dev/null || break
    done
    rm -f "$RESOLV_HONK"
}

start_service() {
    local enabled config_file

    config_load "$CONF"
    config_get_bool enabled "config" "enabled" "0"
    [ "$enabled" -eq "1" ] || return 1

    config_get config_file "config" "config_file" "/etc/honk/config.dae"

    if [ ! -x "$PROG" ]; then
        logger -t honk "not starting: $PROG is missing or not executable"
        return 1
    fi
    if [ ! -f "$config_file" ]; then
        logger -t honk "not starting: config file $config_file is missing"
        return 1
    fi

    set_chmod_640
    preflight || return 1
    check_conflicts || return 1
    sync_api_config || return 1
    sync_local_direct || return 1
    cleanup_netns || return 1
    hijack_resolv_conf

    procd_open_instance "$CONF"
    # mimalloc pre-reserves a 1 GiB arena; VSZ only, but it dwarfs the real
    # footprint in ps. MIMALLOC_ARENA_RESERVE=0: grow on demand instead.
    procd_set_param env DAE_LOCATION_ASSET="/usr/share/v2ray" MIMALLOC_ARENA_RESERVE="0"
    procd_set_param command "$PROG" --config "$config_file"
    procd_set_param netdev "$HONK_HOST_IFACE" "$HONK_PEER_IFACE"
    procd_set_param limits core="unlimited"
    procd_set_param limits nofile="1000000 1000000"
    procd_set_param term_timeout 8
    procd_set_param respawn 3600 5 5
    procd_set_param stderr 1
    procd_close_instance
}

service_stopped() {
    restore_resolv_conf
    cleanup_netns
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger "$CONF"
}

hot_reload() {
    set_chmod_640
    if /etc/init.d/honk running; then
        "$PROG" reload
    else
        start
    fi
}

local_direct() {
    sync_local_direct || return 1
    if /etc/init.d/honk running; then
        "$PROG" reload
    fi
}
